# ─────────────────────────────────────────────────────────────────────────────
# audio-platform settings. Copy to .env with `make env` (never overwrites).
# Naming: AUDIO_<GROUP>__<FIELD>. Secrets are blank here and have no defaults.
# Values below target `make run` on the host; `make up` overrides hosts and dev
# credentials for the container network in docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
# Deployment environment: dev | test | prod. Default: dev
AUDIO_ENV=dev
# Log level: DEBUG | INFO | WARNING | ERROR. Default: INFO
AUDIO_LOG_LEVEL=INFO
# Log format: json (one event per line) | console (human-readable, dev only). Default: json
AUDIO_LOG_FORMAT=console
# Per-dependency timeout for GET /health/ready, seconds. Default: 2.0
AUDIO_HEALTH_CHECK_TIMEOUT_S=2.0

# ── HTTP API ─────────────────────────────────────────────────────────────────
# Bind address and port. Defaults: 0.0.0.0 / 8000
AUDIO_API__HOST=0.0.0.0
AUDIO_API__PORT=8000
# Allowed CORS origins, JSON list. Empty list disables CORS. Default: []
AUDIO_API__CORS_ORIGINS=["http://localhost:5173"]
# Serve /docs and /openapi.json: true | false. Empty: enabled unless AUDIO_ENV=prod
AUDIO_API__DOCS_ENABLED=

# ── PostgreSQL (system of record) ────────────────────────────────────────────
# REQUIRED secret. Must use the asyncpg driver.
# Local (`make infra-up`): postgresql+asyncpg://app:app@localhost:5432/audio_platform
AUDIO_POSTGRES__DSN=
# Connection pool size and overflow. Defaults: 10 / 5
AUDIO_POSTGRES__POOL_SIZE=10
AUDIO_POSTGRES__MAX_OVERFLOW=5
# Seconds to wait for a pooled connection / a new connection. Defaults: 5.0 / 5.0
AUDIO_POSTGRES__POOL_TIMEOUT_S=5.0
AUDIO_POSTGRES__CONNECT_TIMEOUT_S=5.0
# Server-side statement timeout, milliseconds (0 = none). Default: 15000
AUDIO_POSTGRES__STATEMENT_TIMEOUT_MS=15000

# ── AWS / S3 client ──────────────────────────────────────────────────────────
# Region. Default: eu-central-1
AUDIO_AWS__REGION=eu-central-1
# S3-compatible endpoint; leave empty on AWS. Local (RustFS): http://localhost:9000
AUDIO_AWS__ENDPOINT_URL=http://localhost:9000
# Bucket addressing: virtual | path | auto. AWS: virtual (regional presigned URLs). RustFS: path. Default: virtual
AUDIO_AWS__S3_ADDRESSING_STYLE=path
# Client timeouts (seconds) and total attempts incl. retries (standard mode). Defaults: 5.0 / 30.0 / 3
AUDIO_AWS__CONNECT_TIMEOUT_S=5.0
AUDIO_AWS__READ_TIMEOUT_S=30.0
AUDIO_AWS__MAX_ATTEMPTS=3

# ── Object storage ───────────────────────────────────────────────────────────
# REQUIRED. Bucket for audio recordings (<project>-<env>-recordings). Also used by `make up` to create it locally.
AUDIO_STORAGE__BUCKET=audio-platform-dev-recordings
# Endpoint for presigned URLs when clients reach storage on another host than the API
# (`make up` sets it to http://localhost:9000). Empty: same as AUDIO_AWS__ENDPOINT_URL.
AUDIO_STORAGE__PUBLIC_ENDPOINT_URL=

# ── Uploads ──────────────────────────────────────────────────────────────────
# Largest accepted recording, bytes. Default: 2147483648 (2 GiB)
AUDIO_UPLOAD__MAX_SIZE_BYTES=2147483648
# Multipart part size, bytes; 5 MiB..5 GiB, max 10000 parts per file. Default: 16777216 (16 MiB)
AUDIO_UPLOAD__PART_SIZE_BYTES=16777216
# Presigned part URL lifetime, seconds (60..3600). Default: 900
AUDIO_UPLOAD__URL_TTL_S=900
# Accepted content types, JSON list. Empty: mp3, wav, m4a/mp4, aac, ogg, flac, webm audio.
AUDIO_UPLOAD__ALLOWED_CONTENT_TYPES=

# ── Messaging (SQS API; ElasticMQ locally) ───────────────────────────────────
# SQS-compatible endpoint; leave empty on AWS. Local (ElasticMQ): http://localhost:9324
AUDIO_MESSAGING__ENDPOINT_URL=http://localhost:9324
# Queue names (each has a DLQ; see docker/elasticmq/elasticmq.conf)
AUDIO_MESSAGING__PIPELINE_EVENTS_QUEUE=audio-platform-dev-pipeline-events
AUDIO_MESSAGING__VAD_TASKS_QUEUE=audio-platform-dev-vad-tasks
# Long-poll wait, seconds (0..20); keep below the stop grace period (compose: 60 s). Default: 20
AUDIO_MESSAGING__WAIT_TIME_S=20
# Message lease, seconds; busy workers keep extending it. Default: 60
AUDIO_MESSAGING__VISIBILITY_TIMEOUT_S=60
# Attempts before a task is marked failed; keep below the queues' maxReceiveCount (5). Default: 3
AUDIO_MESSAGING__MAX_ATTEMPTS=3
# Longest a single message may be handled, seconds; then it is retried. Must exceed
# AUDIO_PROCESSING__ANALYSIS_TIMEOUT_S. Default: 3600
AUDIO_MESSAGING__HANDLER_TIMEOUT_S=3600
# Outbox relay: rows per batch and idle poll interval (seconds). Defaults: 50 / 1.0
AUDIO_MESSAGING__RELAY_BATCH_SIZE=50
AUDIO_MESSAGING__RELAY_INTERVAL_S=1.0
# Published outbox rows are deleted after this many days; cleanup runs every N seconds.
# Defaults: 7 / 3600
AUDIO_MESSAGING__OUTBOX_RETENTION_DAYS=7
AUDIO_MESSAGING__OUTBOX_CLEANUP_INTERVAL_S=3600

# ── Processing (VAD workers) ─────────────────────────────────────────────────
# Longest accepted recording, seconds. Default: 14400 (4 h)
AUDIO_PROCESSING__MAX_DURATION_S=14400
# Decoding + VAD run in a child process that is killed after this many seconds. Default: 1800
AUDIO_PROCESSING__ANALYSIS_TIMEOUT_S=1800
# Silero VAD: speech threshold (0..1), min speech / min silence / padding in ms.
# Defaults: 0.5 / 250 / 100 / 30 (Silero's own defaults)
AUDIO_PROCESSING__VAD_THRESHOLD=0.5
AUDIO_PROCESSING__VAD_MIN_SPEECH_MS=250
AUDIO_PROCESSING__VAD_MIN_SILENCE_MS=100
AUDIO_PROCESSING__VAD_SPEECH_PAD_MS=30

# ── Auth ─────────────────────────────────────────────────────────────────────
# dev_header: trusts the X-Dev-User-Id header (a UUID). Refused when AUDIO_ENV=prod.
AUDIO_AUTH__MODE=dev_header

# ── AWS credentials (standard SDK variables, read by the default credential chain) ──
# On AWS (ECS), leave all of these unset: the task role provides credentials.
# Local RustFS: dev credentials from docker-compose.yml (rustfs-dev / rustfs-dev-secret).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Real S3 from the host: leave the keys blank and use the output of `make tf-app-env` instead.
# Keep AWS_PROFILE commented out when unused: an empty value breaks the SDK credential chain.
# AWS_PROFILE=audio-platform-dev-app
