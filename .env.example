# ─────────────────────────────────────────────────────────────────────────────
# audio-platform settings. Copy to .env with `make env` (never overwrites).
# Naming: AUDIO_<GROUP>__<FIELD>. Secrets are blank here and have no defaults.
# Values below target `make run` on the host; `make up` overrides hosts and dev
# credentials for the container network in docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
# Deployment environment: dev | test | prod. Default: dev
AUDIO_ENV=dev
# Log level: DEBUG | INFO | WARNING | ERROR. Default: INFO
AUDIO_LOG_LEVEL=INFO
# Log format: json (one event per line) | console (human-readable, dev only). Default: json
AUDIO_LOG_FORMAT=console
# Per-dependency timeout for GET /health/ready, seconds. Default: 2.0
AUDIO_HEALTH_CHECK_TIMEOUT_S=2.0

# ── HTTP API ─────────────────────────────────────────────────────────────────
# Bind address and port. Defaults: 0.0.0.0 / 8000
AUDIO_API__HOST=0.0.0.0
AUDIO_API__PORT=8000
# Allowed CORS origins, JSON list. Empty list disables CORS. Default: []
AUDIO_API__CORS_ORIGINS=["http://localhost:5173"]
# Serve /docs and /openapi.json: true | false. Empty: enabled unless AUDIO_ENV=prod
AUDIO_API__DOCS_ENABLED=

# ── PostgreSQL (system of record) ────────────────────────────────────────────
# REQUIRED secret. Must use the asyncpg driver.
# Local (`make infra-up`): postgresql+asyncpg://app:app@localhost:5432/audio_platform
AUDIO_POSTGRES__DSN=
# Connection pool size and overflow. Defaults: 10 / 5
AUDIO_POSTGRES__POOL_SIZE=10
AUDIO_POSTGRES__MAX_OVERFLOW=5
# Seconds to wait for a pooled connection / a new connection. Defaults: 5.0 / 5.0
AUDIO_POSTGRES__POOL_TIMEOUT_S=5.0
AUDIO_POSTGRES__CONNECT_TIMEOUT_S=5.0
# Server-side statement timeout, milliseconds (0 = none). Default: 15000
AUDIO_POSTGRES__STATEMENT_TIMEOUT_MS=15000

# ── AWS / S3 client ──────────────────────────────────────────────────────────
# Region. Default: eu-central-1
AUDIO_AWS__REGION=eu-central-1
# S3-compatible endpoint; leave empty on AWS. Local (RustFS): http://localhost:9000
AUDIO_AWS__ENDPOINT_URL=http://localhost:9000
# Bucket addressing: auto | virtual | path. RustFS needs path. Default: auto
AUDIO_AWS__S3_ADDRESSING_STYLE=path
# Client timeouts (seconds) and total attempts incl. retries (standard mode). Defaults: 5.0 / 30.0 / 3
AUDIO_AWS__CONNECT_TIMEOUT_S=5.0
AUDIO_AWS__READ_TIMEOUT_S=30.0
AUDIO_AWS__MAX_ATTEMPTS=3

# ── Object storage ───────────────────────────────────────────────────────────
# REQUIRED. Bucket for audio recordings (<project>-<env>-recordings). Also used by `make up` to create it locally.
AUDIO_STORAGE__BUCKET=audio-platform-dev-recordings

# ── AWS credentials (standard SDK variables, read by the default credential chain) ──
# Local only. On AWS, leave unset: the task role provides credentials.
# Local (RustFS dev credentials from docker-compose.yml): rustfs-dev / rustfs-dev-secret
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
